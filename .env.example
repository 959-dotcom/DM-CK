# --- Core ---
# Leave unset locally to use in-memory PGlite (auto-migrates + seeds).
# publish-app sets this automatically when cursor-app.json declares postgres.
DATABASE_URL=
# Optional direct (unpooled) URL for migrate advisory lock
DATABASE_URL_UNPOOLED=

# JWT session signing (required in production)
JWT_SECRET=change-me-to-a-long-random-string
# Access token TTL (jose format) and cookie max-age seconds
JWT_ACCESS_TTL=2h
JWT_ACCESS_MAX_AGE_SEC=7200

# Optional public host allowlist hint for CSRF Origin checks (comma not used; single host)
# NEXT_PUBLIC_APP_HOST=db357.com

# --- PromptPay / Slip verification ---
# Owner PromptPay phone / ID (default used in code if unset)
PROMPTPAY_ID=0846301733
# SlipOK live verify: POST https://api.slipok.com/api/line/apikey/<BRANCH_ID>
# Header x-authorization: <API_KEY>; multipart fields: files, amount, log
# When SLIPOK_API_KEY is unset, verify runs in mock mode only.
SLIPOK_API_KEY=
# Branch/shop id (default in code: 80454)
SLIPOK_BRANCH_ID=80454

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Admin notify group (payment approved / domain alerts), e.g. -1004372199761
TELEGRAM_ADMIN_CHAT_ID=
# Backup slip Approve/Reject group (manual review when SlipOK fails), e.g. -1004319027377
TELEGRAM_SLIP_APPROVE_CHAT_ID=
# Secret for Telegram webhook header X-Telegram-Bot-Api-Secret-Token
# (falls back to WORKER_SECRET when unset)
TELEGRAM_WEBHOOK_SECRET=

# --- Job queue ---
# When set, BullMQ + Redis is used. When unset, in-process setInterval runs.
REDIS_URL=
# In-process tick interval (ms), default 60000
CHECK_TICK_MS=60000
# Protect /api/worker/tick in production (header x-worker-secret)
WORKER_SECRET=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when set
CRON_SECRET=

# --- Security / rate limits / lockout ---
# Max slip upload size in bytes (default 5MB)
MAX_SLIP_BYTES=5242880
# Failed logins before lockout window
LOGIN_MAX_FAILURES=5
# Progressive lock base / max (seconds)
LOGIN_LOCK_BASE_SEC=30
LOGIN_LOCK_MAX_SEC=900

# --- Seed ---
# Local/dev bootstrap admin (plaintext only via env — never commit real prod password)
SEED_ADMIN_EMAIL=admin@spinlytics.local
SEED_ADMIN_PASSWORD=admin123!
# Production admin admin@db357.com is seeded via bcrypt hash in migrations/002_security_admin.sql

# --- Demo / debug ---
# Force all domain probes to BLOCKED (for alert testing)
DEMO_FORCE_BLOCK=0

# --- Domain check notes ---
# Checks use public DNS + HTTP from the app host (Vercel), not residential
# Thai ISP vantage points. See README "Domain check assumptions".
