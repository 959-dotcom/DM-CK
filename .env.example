# --- Core ---
# Leave unset locally to use in-memory PGlite (auto-migrates + seeds).
# publish-app sets this automatically when cursor-app.json declares postgres.
DATABASE_URL=
# Optional direct (unpooled) URL for migrate advisory lock
DATABASE_URL_UNPOOLED=

# JWT session signing (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# --- PromptPay / Slip verification ---
# Owner PromptPay phone / ID (default used in code if unset)
PROMPTPAY_ID=0846301733
# SlipOK live verify: POST https://api.slipok.com/api/line/apikey/<BRANCH_ID>
# Header x-authorization: <API_KEY>; multipart fields: files, amount, log
# When SLIPOK_API_KEY is unset, verify runs in mock mode only.
SLIPOK_API_KEY=
# Branch/shop id (default in code: 80454)
SLIPOK_BRANCH_ID=80454

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Job queue ---
# When set, BullMQ + Redis is used. When unset, in-process setInterval runs.
REDIS_URL=
# In-process tick interval (ms), default 60000
CHECK_TICK_MS=60000
# Protect /api/worker/tick in production
WORKER_SECRET=

# --- Seed ---
SEED_ADMIN_EMAIL=admin@spinlytics.local
SEED_ADMIN_PASSWORD=admin123!

# --- Demo / debug ---
# Force all domain probes to BLOCKED (for alert testing)
DEMO_FORCE_BLOCK=0
