// Prisma-shaped schema kept in sync with migrations/*.sql
// Runtime uses pg + PGlite via src/lib/db.ts (publish-app compatible).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DomainStatus {
  ACTIVE
  BLOCKED
}

enum IspStatus {
  SAFE
  BLOCKED
  UNKNOWN
  ERROR
}

model Plan {
  id                   String   @id
  name                 String
  code                 String?  @unique
  /// Legacy single price — mirrors price_monthly for paid tiers / 0 for free.
  price                Decimal  @db.Decimal(12, 2)
  priceMonthly         Decimal? @map("price_monthly") @db.Decimal(12, 2)
  priceYearly          Decimal? @map("price_yearly") @db.Decimal(12, 2)
  maxDomains           Int      @map("max_domains")
  /// Free trial length, or days for a MONTHLY cycle purchase (30). YEARLY uses 365.
  intervalDays         Int      @map("interval_days")
  checkIntervalMinutes Int      @default(60) @map("check_interval_minutes")
  historyDays          Int      @default(7) @map("history_days")
  maxTelegramGroups    Int      @default(1) @map("max_telegram_groups")
  badge                String?
  sortOrder            Int      @default(100) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  users                User[]
  transactions         Transaction[]

  @@map("plans")
}

model User {
  id                 String             @id
  email              String             @unique
  password           String
  role               Role               @default(USER)
  /// Legacy single chat id (first of telegram_chat_ids).
  telegramChatId     String?            @map("telegram_chat_id")
  /// JSON array of Telegram chat/group IDs (up to plan.max_telegram_groups).
  telegramChatIds    String?            @map("telegram_chat_ids")
  subscriptionStatus SubscriptionStatus @default(FREE) @map("subscription_status")
  /// current_plan_id
  planId             String?            @map("plan_id")
  /// expire_at
  planExpireAt       DateTime?          @map("plan_expire_at")
  billingCycle       BillingCycle?      @map("billing_cycle")
  extraDomainSlots   Int                @default(0) @map("extra_domain_slots")
  disabled           Boolean            @default(false)
  failedLoginCount   Int                @default(0) @map("failed_login_count")
  lockedUntil        DateTime?          @map("locked_until")
  createdAt          DateTime           @default(now()) @map("created_at")
  plan               Plan?              @relation(fields: [planId], references: [id])
  transactions       Transaction[]
  addonPurchases     AddonPurchase[]
  domains            Domain[]

  @@map("users")
}

model SystemMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("system_meta")
}

model LoginAttempt {
  id        String   @id
  email     String
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_attempts")
}

model Transaction {
  id            String         @id
  userId        String         @map("user_id")
  planId        String         @map("plan_id")
  amount        Decimal        @db.Decimal(12, 2)
  billingCycle  BillingCycle?  @map("billing_cycle")
  slipUrl       String?        @map("slip_url")
  paymentStatus PaymentStatus  @default(PENDING) @map("payment_status")
  qrRef         String?        @map("qr_ref")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan           @relation(fields: [planId], references: [id])

  @@map("transactions")
}

model AddonPurchase {
  id            String        @id
  userId        String        @map("user_id")
  slots         Int
  amount        Decimal       @db.Decimal(12, 2)
  slipUrl       String?       @map("slip_url")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  qrRef         String?       @map("qr_ref")
  createdAt     DateTime      @default(now()) @map("created_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addon_purchases")
}

model Domain {
  id                String       @id
  userId            String       @map("user_id")
  url               String
  status            DomainStatus @default(ACTIVE)
  lastCheckedAt     DateTime?    @map("last_checked_at")
  monitoringEnabled Boolean      @default(true) @map("monitoring_enabled")
  createdAt         DateTime     @default(now()) @map("created_at")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkLogs         DomainCheckLog[]

  @@map("domains")
}

model DomainCheckLog {
  id         String    @id
  domainId   String    @map("domain_id")
  aisStatus  IspStatus @default(UNKNOWN) @map("ais_status")
  trueStatus IspStatus @default(UNKNOWN) @map("true_status")
  dtacStatus IspStatus @default(UNKNOWN) @map("dtac_status")
  tbbStatus  IspStatus @default(UNKNOWN) @map("tbb_status")
  ntStatus   IspStatus @default(UNKNOWN) @map("nt_status")
  checkedAt  DateTime  @default(now()) @map("checked_at")
  domain     Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_check_logs")
}
