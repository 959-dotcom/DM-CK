// Prisma-shaped schema kept in sync with migrations/001_init.sql
// Runtime uses pg + PGlite via src/lib/db.ts (publish-app compatible).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  FREE
  TRIAL
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DomainStatus {
  ACTIVE
  BLOCKED
}

enum IspStatus {
  SAFE
  BLOCKED
  UNKNOWN
  ERROR
}

model Plan {
  id                    String   @id
  name                  String
  price                 Decimal  @db.Decimal(12, 2)
  maxDomains            Int      @map("max_domains")
  intervalDays          Int      @map("interval_days")
  checkIntervalMinutes  Int      @default(60) @map("check_interval_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  users                 User[]
  transactions          Transaction[]

  @@map("plans")
}

model User {
  id                 String             @id
  email              String             @unique
  password           String
  role               Role               @default(USER)
  telegramChatId     String?            @map("telegram_chat_id")
  subscriptionStatus SubscriptionStatus @default(FREE) @map("subscription_status")
  planId             String?            @map("plan_id")
  planExpireAt       DateTime?          @map("plan_expire_at")
  disabled           Boolean            @default(false)
  failedLoginCount   Int                @default(0) @map("failed_login_count")
  lockedUntil        DateTime?          @map("locked_until")
  createdAt          DateTime           @default(now()) @map("created_at")
  plan               Plan?              @relation(fields: [planId], references: [id])
  transactions       Transaction[]
  domains            Domain[]

  @@map("users")
}

model SystemMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("system_meta")
}

model LoginAttempt {
  id        String   @id
  email     String
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("login_attempts")
}

model Transaction {
  id            String        @id
  userId        String        @map("user_id")
  planId        String        @map("plan_id")
  amount        Decimal       @db.Decimal(12, 2)
  slipUrl       String?       @map("slip_url")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  qrRef         String?       @map("qr_ref")
  createdAt     DateTime      @default(now()) @map("created_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan          @relation(fields: [planId], references: [id])

  @@map("transactions")
}

model Domain {
  id                String       @id
  userId            String       @map("user_id")
  url               String
  status            DomainStatus @default(ACTIVE)
  lastCheckedAt     DateTime?    @map("last_checked_at")
  monitoringEnabled Boolean      @default(true) @map("monitoring_enabled")
  createdAt         DateTime     @default(now()) @map("created_at")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkLogs         DomainCheckLog[]

  @@map("domains")
}

model DomainCheckLog {
  id        String    @id
  domainId  String    @map("domain_id")
  aisStatus IspStatus @default(UNKNOWN) @map("ais_status")
  trueStatus IspStatus @default(UNKNOWN) @map("true_status")
  dtacStatus IspStatus @default(UNKNOWN) @map("dtac_status")
  tbbStatus IspStatus @default(UNKNOWN) @map("tbb_status")
  ntStatus  IspStatus @default(UNKNOWN) @map("nt_status")
  checkedAt DateTime  @default(now()) @map("checked_at")
  domain    Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_check_logs")
}
